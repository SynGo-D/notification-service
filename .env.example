NODE_ENV=development
PORT=5003

# Must match main-backend's JWT_SECRET. It authenticates mobile users when
# they register/unregister their own FCM device token.
JWT_SECRET=2fe9fbc5d9a2987fb7658dd54fc2b619c48ca577a4f7ad6bcd75272fa3592051

# Used only for trusted service-to-service send requests. Never put this in
# the mobile application.
INTERNAL_SERVICE_TOKEN=d6283e2f6d40ddc81320f94aa8bb3ce663d471d39860086d87ea217b2822bba2

# Recommended for local development: keep the downloaded Firebase service
# account JSON outside this repository and provide its absolute path here.
GOOGLE_APPLICATION_CREDENTIALS="D:/Projects_CSE/FirebaseSecrets/your-service-account.json"

# Alternative to GOOGLE_APPLICATION_CREDENTIALS: copy these three properties
# from the service-account JSON. Use one credential method, not both.
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n"

FIRESTORE_DEVICE_TOKENS_COLLECTION=device_tokens

# RabbitMQ is optional. Enable it when this service should consume messages
# from the platform's existing notification_queue.
RABBITMQ_ENABLED=false
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_NOTIFICATION_QUEUE=notification_queue
RABBITMQ_PREFETCH=10
RABBITMQ_MAX_RETRIES=3
